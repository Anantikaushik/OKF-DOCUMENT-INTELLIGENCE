GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Set to true only when you want the slower knowledge-graph and entity extraction pass.
ENABLE_KNOWLEDGE_GRAPH_INGESTION=false

# Fast ingest uses native PDF text extraction and skips expensive table
# reconstruction for text-based PDFs. Scanned PDFs still use OCR.
FAST_DOCUMENT_INGESTION=true
FAST_NATIVE_PDF_EXTRACTION=true
DOCLING_BATCH_SIZE=4
# Enable OCR only when fewer than half the pages contain embedded text.
OCR_MIN_TEXT_PAGE_RATIO=0.5
